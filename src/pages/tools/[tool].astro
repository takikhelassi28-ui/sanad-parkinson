---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const toolsData = [
    {
      slug: 'medication-schedule',
      title: 'جدول مواعيد وجرعات أدوية باركنسون وتتبع فترات الفعالية (On/Off Tracker)',
      badge: 'تنظيم دوائي دقيق',
      lead: 'أدوية باركنسون (مثل الليفودوبا) تحتاج لدقة متناهية بالدقيقة في مواعيدها. هذا الجدول المصمم طبياً يساعد المريض والمرافق على تدوين مواعيد كل حبة وتوثيق متى يكون الدواء فعالاً (On) ومتى تبدأ فترة الخمول والتصلب (Off).',
      sections: [
        {
          title: 'تعليمات هامة لتناول أدوية الليفودوبا',
          tips: [
            'تناول حبة الليفودوبا قبل الوجبة بـ 30-45 دقيقة أو بعد الوجبة بساعة كاملة مع كوب ماء وفير.',
            'تجنب تناول الحبة مع وجبة غنية بالبروتينات (كاللحوم أو الحليب والبيض) لأن البروتين ينافس الدواء في الامتصاص بالأمعاء.',
            'لا تسحق حبة الليفودوبا ذات المفعول الممتد (CR) إلا بعد استشارة الصيدلي أو الطبيب.',
            'دوّن في خانة الملاحظات فوراً إذا ظهرت أي حركات لا إرادية سريعة (Dyskinesia).'
          ]
        }
      ],
      tableHeaders: ['الموعد المحدد', 'اسم الدواء والجرعة', 'وقت تناول الحبة الفعلي', 'حالة المريض بعد ساعة (On / Off)', 'ملاحظات (رجفان، دوخة، حركات زائدة)'],
      tableRows: [
        ['07:00 صباحاً', 'سينيميت (Levodopa/Carbidopa) 100/25', '________', '[ ] On ممتاز  [ ] Off تصلب', '______________________'],
        ['11:00 صباحاً', 'سينيميت (Levodopa/Carbidopa) 100/25', '________', '[ ] On ممتاز  [ ] Off تصلب', '______________________'],
        ['03:00 مساءً', 'سينيميت (Levodopa/Carbidopa) 100/25', '________', '[ ] On ممتاز  [ ] Off تصلب', '______________________'],
        ['07:00 مساءً', 'سينيميت (Levodopa/Carbidopa) 100/25', '________', '[ ] On ممتاز  [ ] Off تصلب', '______________________'],
        ['10:30 ليلاً', 'سينيميت ممتد المفعول (CR) 200/50', '________', '[ ] On ممتاز  [ ] Off تصلب', '______________________']
      ]
    },
    {
      slug: 'fall-prevention-checklist',
      title: 'قائمة الفحص الشاملة لتأمين المنزل ومنع السقوط لكبار السن',
      badge: 'أمان وسلامة منزلية',
      lead: 'السقوط هو الخطر الأكبر الذي يهدد استقلالية مريض باركنسون. استخدم هذه القائمة التفصيلية لمراجعة غرف منزلك غرفة بغرفة، وإزالة العوائق التي تسبب التعثر أو الانزلاق.',
      sections: [
        {
          title: 'إرشادات الأمان العامة داخل المنزل',
          tips: [
            'إزالة جميع السجاد الصغير والمشايات الأرضية المتحركة، أو تثبيتها بشريط لاصق مزدوج مانع للانزلاق.',
            'توفير إضاءة كافية ليلاً في الممرات المؤدية من غرفة النوم إلى الحمام (أضواء مستشعر الحركة).',
            'التأكد من خلو ممرات المشي تماماً من الأسلاك الكهربائية، الأحذية، أو ألعاب الأحفاد.',
            'استخدام أحذية منزلية مغلقة ذات نعل مطاطي مانع للانزلاق، وتجنب المشي بالجوارب على السيراميك.'
          ]
        }
      ],
      tableHeaders: ['منطقة المنزل', 'عنصر الأمان المطلوب', 'الحالة الحالية', 'الإجراء المطلوب تصحيحه'],
      tableRows: [
        ['الحمام والمرحاض', 'تركيب مقابض جدارية صلبة بجانب المرحاض وحوض الاستحمام', '[ ] منجز  [ ] يحتاج تركيب', 'تثبيت مقابض ستانلس ستيل قوية'],
        ['أرضية الحمام', 'وضع بساط مطاطي مانع للانزلاق داخل حوض الاستحمام وكرسي استحمام ثابت', '[ ] منجز  [ ] غير متوفر', 'شراء كرسي استحمام بمساند لليدين'],
        ['غرفة النوم', 'تعديل ارتفاع السرير ليكون بمستوى يسمح بلمس القدمين للأرض بسهولة عند الجلوس', '[ ] ملائم  [ ] مرتفع جداً', 'خفض أرجل السرير أو وضع مسند'],
        ['السلالم والدرج', 'وجود درابزين متين على جانبي السلالم وشريط فسفوري على حافة كل درجة', '[ ] آمن  [ ] يحتاج تدعيم', 'تركيب درابزين على كلا الجانبين'],
        ['غرفة المعيشة', 'استخدام كراسي ثابتة ذات مساند ذراعين مرتفعة تساعد على النهوض بسهولة', '[ ] مريحة  [ ] غائرة منخفضة', 'تجنب الكنب المنخفض أو الطري جداً']
      ]
    },
    {
      slug: 'daily-mobility-exercises',
      title: 'جدول التمارين الحركية والتوازن اليومية للوقاية من التصلب',
      badge: 'علاج طبيعي وتأهيل',
      lead: 'الحركة اليومية المنتظمة هي العلاج الأقوى لإبطاء تدهور مرض باركنسون. هذا الجدول يرتب لك تمارين الإطالة والتوازن والمشي بخطوات آمنة يمكن ممارستها في الصالة المنزلية.',
      sections: [
        {
          title: 'قواعد التمرين الآمن لمريض باركنسون',
          tips: [
            'مارس التمارين دائماً أثناء فترة فاعلية الدواء (فترة On) عندما تكون العضلات في أقصى درجات المرونة.',
            'تأكد من وجود كرسي متين أو جدار قريب للاستناد عليه ومنع فقدان التوازن أثناء الوقوف.',
            'توقف فوراً إذا شعرت بالدوار، خفقان القلب، أو ألم غير معتاد في المفاصل.',
            'ركز على "الحركات الكبيرة المبالغ فيها" (Large Amplitude) لمقاومة ميل الجسم للانكماش والخطوات القصيرة.'
          ]
        }
      ],
      tableHeaders: ['اسم التمرين', 'كيفية الأداء والهدف', 'التكرار الموصى به', 'الإنجاز اليومي'],
      tableRows: [
        ['1. المشي بالخطوات العريضة (Big Steps)', 'المشي للأمام مع رفع الركبتين عالياً والتأكيد على ضرب الكعب أولاً بالأرض', '10 خطوات ذهاباً وإياباً (3 جولات)', '[ ] تم الإنجاز بنشاط'],
        ['2. تدوير الجذع والكتفين', 'الجلوس باستقامة ولف الكتفين واليدين بهدوء لليمين ثم لليسار لفك تصلب العمود الفقري', '10 مرات لكل اتجاه ببطء', '[ ] تم الإنجاز بنشاط'],
        ['3. تمديد عضلات الساق الخلفية', 'الاستناد على الجدار ومد ساق واحدة للخلف مع الحفاظ على الكعب ملامساً للأرض', 'تثبيت الوضعية 20 ثانية لكل ساق', '[ ] تم الإنجاز بنشاط'],
        ['4. الوقوف والجلوس من الكرسي (Sit-to-Stand)', 'النهوض من الكرسي دون استخدام اليدين إن أمكن، مع دفع الصدر للأمام والقدمين للخلف', '10 تكرارات منتظمة', '[ ] تم الإنجاز بنشاط'],
        ['5. فتح الصدر والذراعين', 'فرد الذراعين على الجانبين كالجناحين وأخذ نفس عميق لفتح القفص الصدري وتحسين الاستقامة', '5 أنفاس عميقة هادئة', '[ ] تم الإنجاز بنشاط']
      ]
    },
    {
      slug: 'speech-swallowing-exercises',
      title: 'دليل التمارين اليومية لتقوية عضلات النطق، الصوت، والبلع',
      badge: 'تخاطب وبلع آمن',
      lead: 'غالباً ما يسبب باركنسون انخفاضاً تدريجياً في نبرة الصوت (Monotone/Quiet Voice) وتأخراً في منعكس البلع. يهدف هذا الدليل لحماية مجرى التنفس والحفاظ على صوتك مسموعاً وواضحاً للأحباب.',
      sections: [
        {
          title: 'إرشادات لتناول الطعام بأمان وتجنب الشرقة',
          tips: [
            'اجلس في وضعية مستقيمة تماماً بزاوية 90 درجة أثناء الأكل والشرب، وابقَ جالساً لمدة 20 دقيقة بعد الانتهاء.',
            'اخفض ذقنك قليلاً نحو صدرك أثناء البلع (Chin-Tuck Maneuver) لتضييق مدخل القصبة الهوائية.',
            'خذ لقيمات ورشفات صغيرة جداً، وتأكد من ابتلاع اللقمة بالكامل قبل أخذ لقمة جديدة.',
            'تجنب التحدث والضحك أثناء وجود الطعام في الفم لمنع دخول الطعام لمجرى الهواء.'
          ]
        }
      ],
      tableHeaders: ['التمرين الصوتي / العضلي', 'طريقة التطبيق خطوة بخطوة', 'المدة والتكرار', 'التقييم اليومي'],
      tableRows: [
        ['تمرين مد الصوت العالي (LSVT)', 'أخذ نفس عميق وإخراج صوت "آآآآآه" بصوت جهوري قوي ومستقر لأطول فترة ممكنة', 'تكرار 5 مرات مع شرب رشفة ماء', '[ ] صوت قوي وواضح'],
        ['تمرين التدرج النغمي (Pitch Glides)', 'إصدار صوت "أوووه" والصعود به من النغمة المنخفضة إلى أعلى نغمة ثم الهبوط بهدوء', 'تكرار 5 مرات يومياً', '[ ] مرونة صوتية جيدة'],
        ['تمارين الشفاه والخدود', 'ضم الشفتين بقوة للأمام (كالتصفير أو التقبيل) ثم الابتسامة العريضة مع إظهار الأسنان', '10 تكرارات لتقوية إغلاق الفم', '[ ] إغلاق شفتين محكم'],
        ['تمرين البلع الجاف بجهد (Effortful Swallow)', 'ابتلاع الريق مع عصر عضلات الحلق واللسان بقوة كأنك تبتلع حبة عنب كاملة', '5 مرات متتالية', '[ ] بلع قوي ومطمئن']
      ]
    },
    {
      slug: 'caregiver-weekly-log',
      title: 'مفكرة المتابعة الأسبوعية للأعراض لتقديمها لطبيب الأعصاب',
      badge: 'متابعة طبية دقيقة',
      lead: 'تستغرق زيارة طبيب الأعصاب دقائق معدودة؛ وجود هذه المفكرة الأسبوعية المنظمة يمنح الطبيب صورة حقيقية عن استجابة المريض للعلاج، ويساعده في ضبط الجرعات وتجنب التخمين.',
      sections: [
        {
          title: 'ما الذي يجب التركيز عليه خلال الأسبوع؟',
          tips: [
            'سجل عدد المرات التي حدث فيها تعثر أو كاد المريض أن يسقط.',
            'لاحظ أوقات اليوم التي يشتكي فيها المريض من ثقل أو بطء شديد (هل هي قبل موعد الحبة التالية؟).',
            'سجل جودة نوم المريض: هل يصرخ أو يتحرك بعنف أثناء النوم؟ هل يستيقظ متصلباً في الصباح؟',
            'سجل أي تغير في المزاج، مثل القلق المفاجئ، نوبات الحزن، أو رؤية أشياء غير موجودة (هلاوس خفيفة).'
          ]
        }
      ],
      tableHeaders: ['اليوم', 'أفضل فترة نشاط (Peak On)', 'فترة التصلب الأسوأ (Off)', 'حوادث تعثر أو سقوط', 'المزاج العام والأعراض الجانبية'],
      tableRows: [
        ['السبت', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الأحد', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الإثنين', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الثلاثاء', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الأربعاء', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الخميس', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________'],
        ['الجمعة', 'من ____ إلى ____', 'من ____ إلى ____', '[ ] لا يوجد   [ ] عدد: __', '________________________']
      ]
    }
  ];

  return toolsData.map((tool) => ({
    params: { tool: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<BaseLayout title={tool.title} description={tool.lead}>

  <!-- Hero -->
  <section class="tool-hero no-print">
    <div class="container--narrow">
      <span class="badge badge--accent">{tool.badge}</span>
      <h1 class="tool-hero__title">{tool.title}</h1>
      <p class="tool-hero__lead">{tool.lead}</p>

      <div class="action-bar">
        <button type="button" class="btn btn--accent btn--print" onclick="window.print()">
          🖨️ طباعة أو حفظ كملف PDF
        </button>
        <a href="/tools/" class="btn btn--outline">
          ← العودة لكل الأدوات
        </a>
      </div>
    </div>
  </section>

  <!-- Printable Area -->
  <div class="printable-container">
    <div class="print-header">
      <div class="print-logo">🩺 سَنَد — منصة رعاية مرضى باركنسون (sanadparkinson.com)</div>
      <h2>{tool.title}</h2>
      <div class="print-meta-grid">
        <div><strong>اسم المريض:</strong> ________________________</div>
        <div><strong>التاريخ:</strong> ___ / ___ / 2026 م</div>
        <div><strong>الطبيب المعالج:</strong> ____________________</div>
        <div><strong>اسم المرافق:</strong> ______________________</div>
      </div>
    </div>

    <!-- Sections -->
    {tool.sections.map((sec) => (
      <div class="tool-section-card">
        <h3>💡 {sec.title}</h3>
        <ul>
          {sec.tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Dynamic Table -->
    <div class="table-scroll-hint no-print">👈 مرر الجدول أفقياً للاطلاع على كافة الأعمدة 👉</div>
    <div class="tool-table-wrapper">
      <table class="tool-table">
        <thead>
          <tr>
            {tool.tableHeaders.map((header) => (
              <th>{header}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tool.tableRows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="print-footer">
      <p>طُبعت هذه الأداة مجاناً من منصة سَنَد لرعاية مرضى باركنسون • استشر دائماً طبيب الأعصاب المتابع لضبط الجرعات الفردية</p>
    </div>
  </div>

</BaseLayout>

<style>
  .tool-hero {
    background: linear-gradient(135deg, var(--color-primary-xlight) 0%, #ffffff 70%);
    padding: var(--space-xl) 0 var(--space-lg);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }
  .tool-hero__title {
    font-size: clamp(1.65rem, 3.5vw, 2.3rem);
    color: var(--color-primary);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.35;
  }
  .tool-hero__lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto var(--space-md);
  }
  .action-bar {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .btn--print {
    font-size: 1.05rem;
    padding: 0.85rem 1.8rem;
  }
  .printable-container {
    max-width: 900px;
    margin: var(--space-xl) auto;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
    box-sizing: border-box;
    width: 100%;
  }
  .print-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .print-logo {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-primary);
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
  }
  .print-header h2 {
    font-size: 1.45rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .print-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    background: var(--color-bg);
    padding: 1rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
  }
  .tool-section-card {
    background: #f8fafc;
    border-right: 4px solid var(--color-accent);
    padding: 1.2rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
  }
  .tool-section-card h3 {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .tool-section-card ul {
    padding-right: 1.5rem;
    margin: 0;
  }
  .tool-section-card li {
    font-size: 0.95rem;
    line-height: 1.75;
    color: #334155;
    margin-bottom: 0.35rem;
  }
  .table-scroll-hint {
    display: none;
    font-size: 0.82rem;
    color: var(--color-primary);
    font-weight: 700;
    text-align: center;
    background: var(--color-primary-xlight);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.6rem;
    border: 1px dashed var(--color-primary-light);
  }
  .tool-table-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--color-border);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
    box-sizing: border-box;
  }
  .tool-table-wrapper::-webkit-scrollbar {
    height: 7px;
  }
  .tool-table-wrapper::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
  }
  .tool-table-wrapper::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 4px;
  }
  .tool-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 0;
  }
  .tool-table th, .tool-table td {
    border: 1px solid var(--color-border);
    padding: 0.75rem 0.85rem;
    text-align: right;
    vertical-align: middle;
  }
  .tool-table th {
    background: var(--color-primary);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    white-space: nowrap;
  }
  .tool-table tr:nth-child(even) {
    background: #f8fafc;
  }
  .print-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
    text-align: center;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .printable-container {
      padding: 1.25rem 0.75rem;
      margin: 1rem auto;
      border-radius: var(--radius-md);
    }
    .print-header h2 {
      font-size: 1.2rem;
      line-height: 1.4;
    }
    .print-logo {
      font-size: 0.92rem;
    }
    .print-meta-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      font-size: 0.88rem;
      padding: 0.75rem;
    }
    .table-scroll-hint {
