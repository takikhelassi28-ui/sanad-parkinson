---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
} = Astro.props;

const siteName = 'سند - دليل رعاية مريض باركنسون';
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="google9ab2d84d79fefc45" />

    <!-- SEO Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ar_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Noto Kufi Arabic + Noto Naskh Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;600;700;900&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global Styles -->
    <style is:global>
      :root {
        --color-primary: #1e3a8a;       /* Deep Medical Blue */
        --color-primary-light: #2563eb;
        --color-primary-xlight: #eff6ff;/* Soft Ice Blue */
        --color-accent: #d97706;        /* Warm Gold/Amber */
        --color-accent-light: #fef3c7;
        --color-text: #0f172a;          /* Slate Dark */
        --color-text-muted: #475569;
        --color-bg: #f8fafc;
        --color-surface: #ffffff;
        --color-border: #e2e8f0;

        --font-display: 'Noto Kufi Arabic', system-ui, sans-serif;
        --font-body: 'Noto Naskh Arabic', Georgia, serif;

        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 20px;

        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
        --shadow-md: 0 4px 16px rgba(30, 58, 138, 0.08);
        --shadow-lg: 0 12px 32px rgba(30, 58, 138, 0.12);

        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 1.5rem;
        --space-lg: 2.5rem;
        --space-xl: 4rem;
        --space-2xl: 6rem;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-body);
        font-size: 16px;
        color: var(--color-text);
        background-color: var(--color-bg);
        direction: rtl;
        line-height: 1.8;
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      main {
        flex: 1;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-display);
        line-height: 1.4;
        color: var(--color-text);
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--color-accent);
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      .container {
        width: 100%;
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 var(--space-sm);
      }

      .container--narrow {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        padding: 0 var(--space-sm);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.6rem;
        border-radius: var(--radius-md);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn--primary {
        background: var(--color-primary);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(30, 58, 138, 0.25);
      }

      .btn--primary:hover {
        background: var(--color-primary-light);
        transform: translateY(-2px);
      }

      .btn--accent {
        background: var(--color-accent);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(217, 119, 6, 0.25);
      }

      .btn--accent:hover {
        background: #b45309;
        transform: translateY(-2px);
      }

      .btn--outline {
        background: transparent;
        border: 2px solid var(--color-primary);
        color: var(--color-primary);
      }

      .btn--outline:hover {
        background: var(--color-primary-xlight);
      }

      .badge {
        display: inline-block;
        padding: 0.25rem 0.85rem;
        border-radius: 100px;
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 700;
        background: var(--color-primary-xlight);
        color: var(--color-primary);
      }

      .badge--accent {
        background: var(--color-accent-light);
        color: var(--color-accent);
      }

      /* Ad Slots Placeholder */
      .ad-slot {
        background: #f1f5f9;
        border: 1px dashed #cbd5e1;
        border-radius: var(--radius-sm);
        padding: 1rem;
        margin: var(--space-md) auto;
        text-align: center;
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      /* Responsive Header & Navigation */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-sm);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        gap: var(--space-md);
      }

      .nav__logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.35rem;
        color: var(--color-primary);
        text-decoration: none;
      }

      .nav__logo span {
        color: var(--color-accent);
      }

      .nav__links {
        display: flex;
        align-items: center;
        list-style: none;
        gap: 1.5rem;
      }

      .nav__links a {
        font-family: var(--font-display);
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .nav__links a:hover {
        color: var(--color-primary);
      }

      .nav__cta {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1.15rem;
        border-radius: 100px;
        background: var(--color-primary);
        color: #ffffff !important;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.88rem;
        box-shadow: 0 2px 8px rgba(30, 58, 138, 0.2);
      }

      .nav__toggle {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        font-size: 1.4rem;
        color: var(--color-primary);
      }

      /* Footer */
      .site-footer {
        background: #0f172a;
        color: rgba(255, 255, 255, 0.8);
        padding: var(--space-xl) 0 var(--space-md);
        margin-top: var(--space-2xl);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: var(--space-lg);
        margin-bottom: var(--space-lg);
      }

      .footer-logo {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.35rem;
        color: #fff;
        margin-bottom: var(--space-sm);
      }

      .footer-brand p {
        font-size: 0.92rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.65);
      }

      .footer-links h4 {
        font-family: var(--font-display);
        font-weight: 800;
        color: #fff;
        margin-bottom: var(--space-sm);
        font-size: 1.05rem;
      }

      .footer-links ul {
        list-style: none;
        padding: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--color-accent);
      }

      .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: var(--space-md);
        text-align: center;
        font-size: 0.85rem;
      }

      .footer-disclaimer {
        color: rgba(255, 255, 255, 0.45);
        margin-top: 0.35rem;
        font-size: 0.8rem;
      }

      /* Responsive Media Queries */
      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--space-md);
        }
      }

      @media (max-width: 820px) {
        .nav__links {
          display: none;
          position: absolute;
          top: 72px;
          right: 0;
          left: 0;
          background: #ffffff;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 0.5rem 1.25rem 1rem;
          border-bottom: 2px solid var(--color-border);
          box-shadow: var(--shadow-md);
          z-index: 999;
        }

        .nav__links.is-open {
          display: flex;
        }

        .nav__links li {
          border-bottom: 1px solid var(--color-primary-xlight);
        }

        .nav__links li:last-child {
          border-bottom: none;
        }

        .nav__links a {
          font-size: 1rem;
          padding: 0.85rem 0.5rem;
          display: block;
        }

        .nav__toggle {
          display: flex;
        }

        .site-footer {
          text-align: center;
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: var(--space-lg);
          text-align: center;
        }

        .footer-brand {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-brand p {
          max-width: 440px;
          margin: 0 auto;
          text-align: center;
        }

        .footer-logo {
          text-align: center;
        }

        .footer-links {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .footer-links h4 {
          text-align: center;
        }

        .footer-links ul {
          padding: 0;
          margin: 0;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .footer-links li {
          text-align: center;
        }

        .footer-links a {
          display: inline-block;
          text-align: center;
        }

        .footer-bottom {
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <!-- Header -->
    <header class="site-header">
      <div class="container">
        <nav class="nav" aria-label="التنقل الرئيسي">
          <a href="/" class="nav__logo">
            🩺 سَنَد <span>| باركنسون</span>
          </a>

          <button
            class="nav__toggle"
            id="navToggle"
            aria-label="فتح القائمة"
            type="button"
          >
            ☰
          </button>

          <ul class="nav__links" id="navLinks">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/articles/">المكتبة العلمية</a></li>
            <li><a href="/tools/">أدوات ومطبوعات</a></li>
            <li><a href="/tests/">اختبارات الملاحظة</a></li>
            <li><a href="/about/">من نحن</a></li>
            <li><a href="/contact/">تواصل معنا</a></li>
            <li><a href="/articles/" class="nav__cta">دليل الرعاية 📘</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="footer-logo">🩺 سَنَد — رعاية باركنسون</div>
            <p>دليلك العربي العلمي المتكامل للتعايش مع مرض باركنسون (الشلل الرعاش) — إرشادات طبية موثوقة، برامج العلاج الطبيعي، وسبل دعم كبار السن وأسرهم.</p>
          </div>
          <div class="footer-links">
            <h4>الأقسام الرئيسية</h4>
            <ul>
              <li><a href="/articles/">جميع المقالات</a></li>
              <li><a href="/tools/">أدوات وجداول PDF</a></li>
              <li><a href="/tests/">اختبارات المتابعة</a></li>
              <li><a href="/about/">من نحن وفريق العمل</a></li>
              <li><a href="/contact/">تواصل معنا</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>محاور هامة</h4>
            <ul>
              <li><a href="/articles/early-parkinson-symptoms/">العلامات المبكرة الخفية</a></li>
              <li><a href="/articles/levodopa-medication-guide/">دليل أدوية ليفودوبا</a></li>
              <li><a href="/articles/fall-prevention-home-safety/">الوقاية من السقوط بالمنزل</a></li>
              <li><a href="/articles/physical-therapy-exercises/">تمارين التوازن اليومية</a></li>
              <li><a href="/articles/caregiver-burnout-support/">دعم المرافق والأسرة</a></li>
            </ul>
          </div>
          <div class="footer-links">
            <h4>قانوني</h4>
            <ul>
              <li><a href="/privacy-policy/">سياسة الخصوصية</a></li>
              <li><a href="/terms/">الشروط والأحكام</a></li>
              <li><a href="/disclaimer/">إخلاء المسؤولية الطبية</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} سَنَد (Sanad Parkinson). جميع الحقوق محفوظة.</p>
          <p class="footer-disclaimer">المحتوى الطبي على هذا الموقع لأغراض تثقيفية وتوعوية عامة فقط، وليس بديلاً عن الفحص الطبي السريري واستشارة طبيب الأعصاب المتخصص.</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      toggle?.addEventListener('click', () => {
        links?.classList.toggle('is-open');
      });
    </script>
  </body>
</html>
